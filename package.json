{
  "name": "dsh-go-magpie",
  "version": "1.3.0",
  "description": "Installs magpie inside DSH Go's built-in Ubuntu environment and keeps its gateway (or gateway plus web console) running, with a native settings panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "magpie",
    "gateway",
    "autostart"
  ],
  "author": "Hipple",
  "homepage": "https://github.com/Hipple/dsh-go-magpie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hipple/dsh-go-magpie.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": { "zh": "Magpie 网关", "en": "Magpie gateway" },
    "icon": "server",
    "contributes": {
      "panels": [
        {
          "id": "magpie",
          "title": { "zh": "Magpie", "en": "Magpie" },
          "icon": "server",
          "placement": ["session.tab", "features", "plugin"]
        }
      ]
    }
  }
}



